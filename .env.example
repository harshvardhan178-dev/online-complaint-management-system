# Flask Configuration
SECRET_KEY=replace-with-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
DATABASE_URL=sqlite:///smartcomplaint.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smartcomplaint_db

# Upload Configuration
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@smartcomplaint.com

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@smartcomplaint.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=System Administrator


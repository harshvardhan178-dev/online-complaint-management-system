# ==============================================================================
# SmartComplaint – Production Environment Variables Template
# Copy this file to .env or configure these variables in your hosting provider
# NEVER commit sensitive credentials or real secrets to version control.
# ==============================================================================

# Core Flask Configuration
FLASK_ENV=production
FLASK_APP=run.py
SECRET_KEY=generate-a-secure-random-64-character-secret-key-here
DEBUG=False

# Production Database (Render / AWS / Supabase / Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-host.singapore.render.com/smartcomplaint
# Render internal private networking URL (optional):
# INTERNAL_DATABASE_URL=postgresql://username:password@smartcomplaint-db:5432/smartcomplaint

# Administrator Account (Automatically provisioned on initial boot if not present)
DEFAULT_ADMIN_EMAIL=admin@smartcomplaint.com
DEFAULT_ADMIN_PASSWORD=SetAStrongPassword123!
DEFAULT_ADMIN_NAME=System Administrator

# File Upload Thresholds (Bytes)
MAX_CONTENT_LENGTH=52428800  # 50 MB
UPLOAD_FOLDER=uploads

# SMTP Email Dispatch (Optional – in-app notifications are primary)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-municipal-alerts@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=noreply@smartcomplaint.com

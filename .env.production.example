# ==============================================================================
# SmartComplaint - Production Environment Template
# Set actual values in Render Dashboard -> Your Web Service -> Environment.
# Never commit real credentials or secrets.
# ==============================================================================

# Flask Configuration
FLASK_ENV=production
FLASK_APP=run.py
SECRET_KEY=
DEBUG=False

# PostgreSQL Database
# Enter the PostgreSQL connection URL provided by your hosting provider.
DATABASE_URL=

# Administrator Account
DEFAULT_ADMIN_EMAIL=admin@smartcomplaint.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=System Administrator

# File Upload Configuration (50 MB)
MAX_CONTENT_LENGTH=52428800
UPLOAD_FOLDER=uploads

# SMTP Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=